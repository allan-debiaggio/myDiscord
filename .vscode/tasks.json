{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build GTK Project",
        "type": "shell",
        "command": "gcc",
        "args": [
          "-o", "${fileBasenameNoExtension}.exe",
          "${file}",
          "$(pkg-config --cflags --libs gtk+-3.0)"
        ],
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": []
      }
    ]
  }